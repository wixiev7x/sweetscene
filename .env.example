# ─────────────────────────────────────────────────────────────────────
# sweetscene — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit
# a filled-in copy of this file.
#
# Most credentials below can ALSO be set at runtime from the admin
# dashboard (/admin/settings), which stores them in the platform_settings
# table and overrides the value here without a redeploy. Anything marked
# ENV-ONLY cannot — it is read before the database is reachable, or
# storing it in the database would defeat its purpose.
#
# ── HONEYTOKENS ────────────────────────────────────────────────────────
# Every credential VALUE in this file is a FAKE CANARY. They look real,
# are published on purpose, and grant nothing anywhere. If any of them
# is ever used against SweetScene (a webhook signature, an API call, an
# auth header), lib/security/canary.ts detects it, raises a CANARY_
# CREDENTIAL_USED critical alert, and rejects the request. Real values
# exist only in Vercel environment variables and local .env.local —
# which is gitignored. Do NOT copy canary values into .env.local.
# ─────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────
# ENV-ONLY. Project Settings → API.
# The service role key bypasses RLS entirely. It must never appear in
# any NEXT_PUBLIC_ variable or reach the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9.eyJpc3MiOiAic3VwYWJhc2UiLCAicmVmIjogImM0bjRyeS0wMDAwMDAwMCIsICJyb2xlIjogImFub24iLCAiaWF0IjogMTc4NTk1NzE2MiwgImV4cCI6IDIxMDE1MzMxNjJ9.YW5vbmNhbmFyeXRva2Vu
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiAiSFMyNTYiLCAidHlwIjogIkpXVCJ9.eyJpc3MiOiAic3VwYWJhc2UiLCAicmVmIjogImM0bjRyeS0wMDAwMDAwMCIsICJyb2xlIjogInNlcnZpY2Vfcm9sZSIsICJpYXQiOiAxNzg1OTU3MTYyLCAiZXhwIjogMjEwMTUzMzE2Mn0.ZGNhbnFzdGFlbGtjYmVnbmRzZmQ

# ── Settings master key (UNUSED — kept for documentation) ────────────
# ENV-ONLY. Historically intended for encrypting dashboard-managed
# secrets. As of 2026-09 it is referenced NOWHERE in the code — secrets
# in platform_settings are protected by column grants + service-role
# access instead. Do not set it anywhere.
SETTINGS_MASTER_KEY=f1e2d3c4b5a697886970615243f4e5d6c7b8a9canary000102030405

# ── Message encryption (required) ────────────────────────────────────
# ENV-ONLY — storing this beside the ciphertext it protects would make
# the encryption decorative.
# Generate with: openssl rand -hex 32
MESSAGE_ENCRYPTION_KEY=d2001b4adbc2e3e4ceddfe9c5c15f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4

# ── Site URL (required) ──────────────────────────────────────────────
# Used to build the OAuth redirect. Must match the deployed origin
# exactly, with no trailing slash, or sign-in silently fails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI provider ──────────────────────────────────────────────────────
# Dashboard-manageable. "deepseek" or "mock". With no key configured
# the platform falls back to canned mock replies rather than erroring.
AI_PROVIDER=deepseek
AI_API_KEY=sk-0173c74c688f6913e6b1e3a0c9d2f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8
DEEPSEEK_ENDPOINT=https://api.deepseek.com/v1/chat/completions

# ── Cloudflare Turnstile (captcha) ───────────────────────────────────
# The SITE key is ENV-ONLY: it is inlined into the client bundle at
# build time, so changing it needs a rebuild either way. The SECRET is
# dashboard-manageable.
# Verification fails CLOSED in production — with no secret set, logins
# are rejected. Leave both blank in development to bypass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=0x0BB5394667866E00C9B6722575_CE_CANARY_9F2A41

# ── NOWPayments (crypto billing) ─────────────────────────────────────
# Dashboard-manageable. The IPN secret signs webhook callbacks; without
# it the webhook rejects every payment notification.
NOWPAYMENTS_API_KEY=3F34110522F3DFE50C396A3375CE8911A6B7D4E2F8C9031B5A6E7F2-SANDBOX-CANARY
NOWPAYMENTS_IPN_SECRET=e5b413b76ba245a9e6de33de7635f19c1eafcb13fbd2904a51c2ef9d3d7841b3
NOWPAYMENTS_API_BASE=https://api.nowpayments.io/v1

# ── Upstash Redis (rate limiting) ────────────────────────────────────
# Dashboard-manageable. OPTIONAL but strongly recommended in production:
# without it the limiter falls back to per-process memory, which does
# not hold across serverless instances — effectively no rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=AX_canary_UPSTASH_9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c

# ── Image generation (optional) ──────────────────────────────────────
# Gemini key is dashboard-manageable. Image generation is a VIP feature
# and degrades to a static fallback image when unconfigured.
GEMINI_API_KEY=AIzaV5F1sgNNV29vGhc-fVAGbu-Z012canary34567890
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
POLLINATIONS_API_URL=https://image.pollinations.ai/prompt/
UNSPLASH_FALLBACK_IMAGE=

# ── Error reporting (optional) ───────────────────────────────────────
# Dashboard-manageable. Server errors and warnings POST here as JSON.
# A Discord or Slack incoming webhook URL works unmodified; so does any
# collector that accepts a JSON body. Blank means errors are written to
# the platform logs and nowhere else.
ERROR_WEBHOOK_URL=https://webhook.site/canary-3fa9c2e1b7d84016

# ── Content moderation (optional, strongly recommended) ──────────────
# Dashboard-manageable. The blocked-term floor in lib/utils/safety.ts
# always runs and needs no configuration; this adds a classifier that
# catches paraphrase, which no keyword list can.
#
# MODERATION_PROVIDER: openai | webhook | none   (default none)
#   openai   — https://api.openai.com/v1/moderations. Free, and does not
#              consume paid credit. MODERATION_API_KEY is an OpenAI key.
#   webhook  — your own endpoint. Receives
#                POST { text, nsfwAllowed, refuse: string[] }
#              and must answer { flagged: boolean, categories?: string[] }.
#              MODERATION_ENDPOINT is required; MODERATION_API_KEY, if
#              set, is sent as a bearer token.
#
# MODERATION_FAIL_CLOSED: true blocks messages when the classifier is
# unreachable. Default false — an outage at the provider should not take
# chat down, and the blocked-term floor still applies either way.
MODERATION_PROVIDER=none
MODERATION_API_KEY=sk-canary-moderation-4f5e6d7c8b9a0z1y2x3w4v5u6t
MODERATION_ENDPOINT=
MODERATION_FAIL_CLOSED=false

# ── Age / ID verification (optional until launch decision) ──────────
# Third-party ID verification (Persona / Veriff / Yoti). Until all
# three are set, every age gate in the app is INERT and the platform
# behaves exactly as before. We store only pass/fail + a reference ID.
# The provider adapter in lib/verification/provider.ts must be
# finished for the chosen provider before keys go live.
AGE_VERIFICATION_PROVIDER=
AGE_VERIFICATION_API_KEY=verif_442d36470cbccf24f106487e3f0b52d3a9c8e7f6g5h4i3j2k1
AGE_VERIFICATION_WEBHOOK_SECRET=agever_canary_7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a

# ── NOWPayments sandbox ─────────────────────────────────────────────
# NOWPayments has a separate sandbox (sandbox.nowpayments.io) with its
# own account and API key. To dry-run the full order → webhook →
# credit chain WITHOUT real money: create a sandbox account, set its
# key above, and point the base at the sandbox API. Without a sandbox
# account, the FIRST live test IS the real-money test. Every payment
# event is logged (np_* events) for end-to-end tracing either way.
# NOWPAYMENTS_API_BASE=https://api.nowpayments.io/v1
