# ─────────────────────────────────────────────────────────────────────
# sweetscene-admin — environment template
#
# Copy to .env.local and fill in. NEVER commit a filled-in copy.
# In Vercel, set these with environment scoping:
#   Production scope → prod Supabase keys
#   Preview scope    → staging Supabase keys
# ─────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Settings master key (required, server-only) ──────────────────────
# Used to encrypt/decrypt AI provider API keys in app_settings table.
# Generate with: openssl rand -hex 32
SETTINGS_MASTER_KEY=
